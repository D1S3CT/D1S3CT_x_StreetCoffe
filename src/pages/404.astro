---
import Header from "../components/layout/Header.astro";
import Footer from "../components/home/Footer.astro";
import SEO from "../components/SEO.astro";

import "../styles/404.css";
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080808" />

    <SEO
      title="Страница не найдена — StreetCoffe"
      description="Кажется, мы свернули не туда. Вернитесь на главную StreetCoffe или загляните в наше меню."
      noindex={true}
    />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>

  <body class="error-page">
    <Header />

    <main class="error-main">
      <section class="error-section">
        <div class="error-container">

          <div class="error-label">
            <span class="error-label-dot"></span>
            STREETCOFFE / 404
          </div>

          <div class="error-number" aria-label="404">
            <span>4</span>
            <span class="error-zero">0</span>
            <span>4</span>
          </div>

          <div class="error-heading">
            <h1>
              Кажется, мы свернули<br />
              <span>не туда.</span>
            </h1>

            <p>
              Похоже, этой страницы больше нет или она никогда
              не существовала. Но не переживайте — хороший кофе
              всегда найдёт дорогу к вам.
            </p>
          </div>

          <div class="error-actions">
            <a href="/" class="error-button error-button-primary">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path
                  d="M3 10.5L12 3L21 10.5V20H14.5V14H9.5V20H3V10.5Z"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>

              На главную
              <span class="error-button-arrow">↗</span>
            </a>

            <a href="/menu/" class="error-button error-button-secondary">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path
                  d="M5 7H19L18 21H6L5 7Z"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linejoin="round"
                />
                <path
                  d="M9 7V5C9 3.9 9.9 3 11 3H13C14.1 3 15 3.9 15 5V7"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                />
                <path
                  d="M9 11V16M12 11V16M15 11V16"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                />
              </svg>

              Посмотреть меню
              <span class="error-button-arrow">↗</span>
            </a>
          </div>

          <div class="error-bottom-note">
            <span></span>
            НЕ ТЕРЯЙСЯ. ЗАГЛЯДЫВАЙ К НАМ ЕЩЁ.
            <span></span>
          </div>

        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>