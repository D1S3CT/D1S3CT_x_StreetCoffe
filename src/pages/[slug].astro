---
import { getCollection, render } from "astro:content";
import BlogLayout from "../layouts/BlogLayout.astro";
import "../styles/article.css";

export async function getStaticPaths() {
  const articles = await getCollection("articles");

  console.log(
    "Найденные статьи:",
    articles.map((article) => ({
      id: article.id,
      title: article.data.title,
    }))
  );

  return articles.map((article) => ({
    params: {
      slug: article.id,
    },
    props: {
      article,
    },
  }));
}

const { article } = Astro.props;

const { Content, headings } = await render(article);

const {
  title,
  description,
  category,
  readingTime,
  heroImage,
  promoImage,
} = article.data;

const allArticles = await getCollection("articles");

const otherArticles = allArticles.filter(
  (item) => item.id !== article.id
);
---

<BlogLayout title={title} description={description}>

  <main class="article-page">

    <section class="article-hero">

      {heroImage && (
        <img
          class="article-hero__image"
          src={heroImage}
          alt=""
          fetchpriority="high"
        />
      )}

      <div class="article-hero__inner">
        <p class="article-hero__crumb">
          <a href="/">Главная</a>
          <span>›</span>
          <a href="/#blog">Статьи</a>
          <span>›</span>
          {category}
        </p>

        <div class="article-hero__copy">
          <p class="article-hero__eyebrow">Статьи</p>

          <h1>{title}</h1>

          <p class="article-hero__description">
            {description}
          </p>

          <div class="article-hero__meta">
            {article.data.date && <span>{article.data.date}</span>}
            {readingTime && <span>{readingTime}</span>}
            {category && <span>{category}</span>}
          </div>
        </div>

      </div>
    </section>


    <div class="article-layout">

      <article class="article-content">
        <Content />
      </article>


      <aside class="article-sidebar">

        {headings.some((heading) => heading.depth === 2) && (
          <section class="article-side-card">

            <h2>
              <img src="/icons/article.svg" alt="" />
              Содержание статьи
            </h2>

            <ol>
              {headings
                .filter((heading) => heading.depth === 2)
                .map((heading, index) => (
                  <li>
                    <a href={`#${heading.slug}`}>
                      <span>{index + 1}</span>
                      {heading.text}
                    </a>
                  </li>
                ))}
            </ol>

          </section>
        )}


        <a class="article-promo" href="/menu">

          {promoImage && (
            <img src={promoImage} alt="" loading="lazy" />
          )}

          <span>
            Попробуй<br />
            новые вкусы<br />
            в StreetCoffe
          </span>

          <b>
            Посмотреть меню <i>›</i>
          </b>

        </a>


<section class="article-side-card article-side-card--links">
  <h2>Другие статьи</h2>

  {otherArticles.map((item) => (
    <a
      class="article-other-link"
      href={`/${item.data.slug}/`}
    >
      <span class="article-other-link__image">
        <img
          src={item.data.heroImage || "/images/articles/default.webp"}
          alt={item.data.title}
          loading="lazy"
        />
      </span>

      <span class="article-other-link__info">
        <span class="article-other-link__title">
          {item.data.title}
        </span>

        <span class="article-other-link__category">
          {item.data.category}
        </span>
      </span>

      <span class="article-other-link__arrow" aria-hidden="true">
        ›
      </span>
    </a>
  ))}
</section>

      </aside>

    </div>

  </main>

</BlogLayout>