---
import "./Hero.css";

const features = [
  {
    title: "Авторские",
    subtitle: "напитки",
    icon: "leaf",
  },
  {
    title: "Популярный",
    subtitle: "Bubble Tea",
    icon: "bubble",
  },
  {
    title: "Кофе",
    subtitle: "с собой",
    icon: "cup",
  },
  {
    title: "Несколько",
    subtitle: "точек в городе",
    icon: "pin",
  },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__background" aria-hidden="true"></div>
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="hero__inner">
    <div class="hero__content">
      <p class="hero__eyebrow">Сеть кофеен в Тольятти</p>

      <h1 class="hero__title" id="hero-title">
        StreetCoffe —<br />
        твоя кофейная<br />
        <span>атмосфера</span><br />
        в Тольятти
      </h1>

      <p class="hero__description">
        Кофе, авторские напитки и Bubble Tea.<br class="desktop-break" />
         Находи любимые вкусы и заглядывай<br class="desktop-break" />
        в ближайшую кофейню StreetCoffee.
      </p>

      <div class="hero__actions">
        <a class="hero-button hero-button--light" href="/menu">
          <img
          class="hero-button__icon"
          src="/icons/CupCoffe_Black.svg"
          alt=""
          aria-hidden="true"
        />
          <span>Посмотреть меню</span>
          <svg class="hero-button__arrow" viewBox="0 0 24 24" aria-hidden="true">
            <path d="m9 5 7 7-7 7" />
          </svg>
        </a>

        <a class="hero-button hero-button--outline" href="#locations">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z" />
            <circle cx="12" cy="10" r="2.5" />
          </svg>
          <span>Найти кофейню</span>
          <svg class="hero-button__arrow" viewBox="0 0 24 24" aria-hidden="true">
            <path d="m9 5 7 7-7 7" />
          </svg>
        </a>
      </div>

      <ul class="hero-features" aria-label="Особенности StreetCoffe">
        {features.map((feature) => (
          <li class="hero-features__item">
            <span class="hero-features__icon" aria-hidden="true">
              {feature.icon === "leaf" && (
                <img src="/icons/Bean.svg" alt="" />
              )}

              {feature.icon === "bubble" && (
                <img src="/icons/Bubble.svg" alt="" />
              )}

              {feature.icon === "cup" && (
                <img src="/icons/Coffe.svg" alt="" />
              )}

              {feature.icon === "pin" && (
                <svg viewBox="0 0 32 32">
                  <path d="M26 13c0 8-10 17-10 17S6 21 6 13a10 10 0 1 1 20 0Z" />
                  <circle cx="16" cy="13" r="3" />
                </svg>
              )}
            </span>
            <span class="hero-features__copy">
              <span>{feature.title}</span>
              <span>{feature.subtitle}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>

    <div class="hero__visual" aria-hidden="true">
      <img
        class="hero__drinks"
        src="/Hero/coffeCups.webp"
        alt=""
        width="1536"
        height="1024"
        fetchpriority="high"
        decoding="async"
      />
    </div>

    <img
      class="hero__leaves"
      src="/Hero/LeavesHero(1).webp"
      alt=""
      aria-hidden="true"
      width="1536"
      height="1024"
      decoding="async"
    />

    <aside class="hero-aside" aria-label="StreetCoffe — больше, чем кофе">
      <p class="hero-aside__script">Больше<br />чем кофе <span>♡</span></p>
      <ul class="hero-aside__list">
        <li>Кофе<br />на каждый<br />день</li>
        <li>Яркие<br />вкусы</li>
        <li>Уютная<br />атмосфера</li>
        <li>Тольятти <span>♡</span></li>
      </ul>
    </aside>
  </div>

  <a class="hero-scroll" href="#categories" aria-label="Прокрутить к следующему разделу">
    <span class="hero-scroll__mouse" aria-hidden="true"><span></span></span>
    <span>Листайте вниз</span>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
  </a>

  <div class="hero__wave" aria-hidden="true"></div>
</section>
