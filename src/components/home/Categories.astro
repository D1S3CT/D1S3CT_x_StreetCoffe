---
import "./Categories.css";

const categories = [
  {
    title: "Кофе",
    description: "Капучино, латте,\nамерикано, раф\nи другие",
    image: "/catalog/CoffeCup.webp",
    imageAlt: "Чашка классического кофе",
    href: "/menu?category=coffee",
    theme: "coffee",
    icon: "/icons/cuppCoffe_black.svg",
    background: "#F5E9DE",
    imageWidth: "84%",
    imageHeight: "76%",
  },
  {
    title: "Bubble Tea",
    description: "Яркие напитки\nс фруктовыми вкусами",
    image: "/catalog/BubbleTea.webp",
    imageAlt: "Яркий Bubble Tea с тапиокой",
    href: "/menu?category=bubble-tea",
    theme: "bubble",
    icon: "/icons/category-bubble-tea.svg",
    background: "#FBE5EB",
    imageWidth: "82%",
    imageHeight: "78%",
  },
  {
    title: "Холодные\nнапитки",
    description: "Айс-кофе\n и лимонады.",
    image: "/catalog/IceCoffe.webp",
    imageAlt: "Освежающий холодный кофейный напиток",
    href: "/menu?category=cold",
    theme: "cold",
    icon: "/icons/category-cold.svg",
    background: "#EAF1F7",
    imageWidth: "82%",
    imageHeight: "78%",
  },
  {
    title: "Авторские\nнапитки",
    description: "Фирменные\nрецепты",
    image: "/catalog/MagicCoffe.webp",
    imageAlt: "Авторский кофейный напиток со сливками",
    href: "/menu?category=signature",
    theme: "signature",
    icon: "/icons/category-signature.svg",
    background: "#F6E9DC",
    imageWidth: "82%",
    imageHeight: "80%",
  },
];
---

<section class="categories" id="categories" aria-labelledby="categories-title">
  <div class="categories__container">

    <div class="categories__heading">
      <div class="categories__heading-main">
        <p class="categories__eyebrow">Популярные категории</p>

        <h2 class="categories__title" id="categories-title">
          Выбирай <span>свой вкус</span>
        </h2>
      </div>

      <p class="categories__description">
        Классический кофе, яркий Bubble Tea,<br class="categories__desktop-break" />
        освежающие холодные напитки<br class="categories__desktop-break" />
        и фирменные авторские сочетания —<br class="categories__desktop-break" />
        всё, что ты любишь, в одном месте.
      </p>

      <p class="categories__handwriting" aria-hidden="true">
        Больше<br />
        чем кофе <span>♡</span>
      </p>
    </div>

    <div class="categories__grid">
      {categories.map((category) => (
        <article
          class:list={["category-card", `category-card--${category.theme}`]}
          style={`
            --card-bg: ${category.background};
            --product-width: ${category.imageWidth};
            --product-height: ${category.imageHeight};
          `}
        >

          <!-- Прозрачное изображение напитка -->
          <img
            class="category-card__image"
            src={category.image}
            alt={category.imageAlt}
            width="800"
            height="1000"
            loading="lazy"
            decoding="async"
          />

          <!-- Текст карточки -->
          <div class="category-card__content">
            <h3 class="category-card__title">
              {category.title.split("\n").map((line) => (
                <>
                  {line}
                  <br />
                </>
              ))}
            </h3>

            <p class="category-card__description">
              {category.description.split("\n").map((line) => (
                <>
                  {line}
                  <br />
                </>
              ))}
            </p>
          </div>

          <!-- Иконка категории -->
          <span class="category-card__badge" aria-hidden="true">
            <img
              src={category.icon}
              alt=""
              width="30"
              height="30"
              loading="lazy"
            />
          </span>

          <!-- Кнопка -->
            <a class="category-card__link" href={category.href}>
              <span>Смотреть</span>

              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="m9 5 7 7-7 7" />
              </svg>
            </a>

        </article>
      ))}
    </div>

    <!-- Полный каталог -->
    <div class="categories-promo">

      <div class="categories-promo__title">
        <p class="categories-promo__eyebrow">Полный ассортимент</p>

        <h3>
          Смотри весь<br />
          <span>каталог напитков</span>
        </h3>
      </div>

      <div class="categories-promo__divider" aria-hidden="true"></div>

      <ul class="categories-promo__benefits">

        <li>
          <img
            src="/icons/Bean.svg"
            alt=""
            width="32"
            height="32"
            aria-hidden="true"
          />
          <span>Более 50<br />напитков</span>
        </li>

        <li>
          <img
            src="/icons/promo-leaf.svg"
            alt=""
            width="32"
            height="32"
            aria-hidden="true"
          />
          <span>
            Классика<br />
            <small>и авторские рецепты</small>
          </span>
        </li>

        <li>
          <img
            src="/icons/promo-heart.svg"
            alt=""
            width="32"
            height="32"
            aria-hidden="true"
          />
          <span>Новые вкусы<br />каждый сезон</span>
        </li>

      </ul>

      <img
        class="categories-promo__watermark"
        src="/header/logo.png"
        alt=""
        aria-hidden="true"
        loading="lazy"
      />

        <a class="categories-promo__button" href="/menu">
          <span>Перейти в каталог</span>

          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="m9 5 7 7-7 7" />
          </svg>
        </a>

    </div>

  </div>
</section>