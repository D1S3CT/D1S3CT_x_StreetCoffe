---
import "./Locations.css";
import { locations } from "../../data/locations";
---

<section class="locations" id="locations">
  <div class="locations__container">

    <!-- Заголовок -->
    <header class="locations__header">
      <div class="locations__heading">
        <p class="locations__eyebrow">Наши кофейни</p>

        <h2 class="locations__title">
          Всегда <span>рядом</span>
        </h2>

        <p class="locations__description">
          StreetCoffee — это уютные кофейни в разных районах Тольятти.
          Выбирай ближайшую и заходи за любимым напитком.
        </p>
      </div>

      <p class="locations__handwriting" aria-hidden="true">
        Тольятти<br />
        вкуснее<br />
        с кофе <span>♡</span>
      </p>
    </header>

    <!-- Основная область -->
    <div class="locations__layout">

      <!-- Левая колонка -->
      <div class="locations__sidebar">

        <!-- Поиск и сортировка -->
        <div class="locations__controls">

          <label class="locations__search">
            <img src="/icons/search.svg" alt="" />

            <input
              class="locations__search-input"
              type="search"
              placeholder="Найти кофейню по адресу..."
              aria-label="Поиск кофейни по адресу"
            />

            <button
              class="locations__search-clear"
              type="button"
              aria-label="Очистить поиск"
            >
              ×
            </button>
          </label>

          <label class="locations__sort">
            <img src="/icons/why-location.svg" alt="" />

            <select
              class="locations__sort-select"
              aria-label="Сортировка кофеен"
            >
              <option value="default">Все кофейни</option>
              <option value="asc">По адресу А—Я</option>
              <option value="desc">По адресу Я—А</option>
            </select>

            <img
              class="locations__sort-arrow"
              src="/icons/chevron-down.svg"
              alt=""
            />
          </label>

        </div>

        <!-- Список кофеен -->
        <div class="locations__list" aria-live="polite">

          {locations.map((location) => (
            <article
              class="location-card"
              data-location-card
              data-location-id={location.id}
              data-id={location.id}
              data-name={location.name.toLowerCase()}
              data-address={location.address.toLowerCase()}
              data-lng={location.lng ?? ""}
              data-lat={location.lat ?? ""}
            >
              <div class="location-card__photo">
                <img
                  src={location.image}
                  alt={`Интерьер кофейни StreetCoffee «${location.name}»`}
                  width="360"
                  height="360"
                  loading="lazy"
                  decoding="async"
                />

                <span class="location-card__photo-fallback">
                  <span>STREET</span>
                  <strong>COFFEE</strong>
                </span>
              </div>

              <div class="location-card__content">

                <h3 class="location-card__title" title={location.name}>
                  {location.name}
                </h3>

                <div class="location-card__address">
                  <img src="/icons/location.svg" alt="" />
                  <span>{location.address}</span>
                </div>

                <div class="location-card__hours">
                  <img src="/icons/clock.svg" alt="" />

                  <span>
                    {location.hours.open} — {location.hours.close}
                  </span>
                </div>

                <a
                  class="location-card__route"
                  href={`https://yandex.ru/maps/?text=${encodeURIComponent(
                    `Тольятти, ${location.address}`
                  )}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Найти маршрут до кофейни «${location.name}»`}
                >
                  Построить маршрут
                  <img src="/icons/arrow_white.svg" alt="" />
                </a>

              </div>
            </article>
          ))}

          <!-- Пустой результат поиска -->
          <div class="locations__empty" hidden>
            <span>☕</span>
            <p>Кофейня по такому адресу не найдена</p>
          </div>

        </div>

        <!-- Счётчик -->
        <div class="locations__count">
          Показано <span data-visible-count>{locations.length}</span>
          из {locations.length} кофеен
        </div>

      </div>

      <!-- Правая колонка — карта -->
      <div class="locations__map-column">

        <div
          class="locations__map"
          aria-label="Интерактивная карта кофеен StreetCoffee"
        >

          <!-- Контейнер MapLibre -->
          <div
            class="locations__map-canvas"
            id="streetcoffe-map"
            aria-label="Карта города Тольятти"
          ></div>

          <!-- Ссылка на карту -->
          <a
            class="locations__map-link"
            href="https://www.openstreetmap.org/#map=12/53.51/49.42"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="locations__map-link-pin"></span>
            Открыть карту
            <img src="/icons/arrow-up-right_block.svg" alt="" />
          </a>

        </div>

      </div>

    </div>
  </div>
</section>

<script>
  import "../../scripts/locations-map.js";

  const initLocations = () => {
    const section = document.querySelector(".locations");

    if (!section || section.hasAttribute("data-initialized")) {
      return;
    }

    const searchInput = section.querySelector(
      ".locations__search-input"
    );

    const clearButton = section.querySelector(
      ".locations__search-clear"
    );

    const sortSelect = section.querySelector(
      ".locations__sort-select"
    );

    const list = section.querySelector(".locations__list");
    const count = section.querySelector("[data-visible-count]");
    const empty = section.querySelector(".locations__empty");

    if (
      !(searchInput instanceof HTMLInputElement) ||
      !(sortSelect instanceof HTMLSelectElement) ||
      !list ||
      !count ||
      !empty
    ) {
      return;
    }

    section.setAttribute("data-initialized", "true");

    const getCards = () =>
      Array.from(
        list.querySelectorAll("[data-location-card]")
      );

    const updateLocations = () => {
      const query = searchInput.value.trim().toLowerCase();
      const sort = sortSelect.value;
      const cards = getCards();

      // Сортировка карточек
      cards.sort((a, b) => {
        const addressA =
          a.getAttribute("data-address") || "";

        const addressB =
          b.getAttribute("data-address") || "";

        if (sort === "asc") {
          return addressA.localeCompare(addressB, "ru");
        }

        if (sort === "desc") {
          return addressB.localeCompare(addressA, "ru");
        }

        return (
          Number(a.getAttribute("data-id")) -
          Number(b.getAttribute("data-id"))
        );
      });

      // Фильтрация карточек
      cards.forEach((card) => {
        const address =
          card.getAttribute("data-address") || "";

        const title =
          card.querySelector(".location-card__title")
            ?.textContent?.toLowerCase() || "";

        const name = card.getAttribute("data-name") || "";

        const matches = `${address} ${title}`.includes(query);

        card.toggleAttribute("hidden", !matches);

        // Перемещаем карточки в соответствии с сортировкой
        list.appendChild(card);
      });

      // Счётчик
      const visible = cards.filter(
        (card) => !card.hasAttribute("hidden")
      ).length;

      count.textContent = String(visible);

      empty.toggleAttribute("hidden", visible !== 0);

      // Кнопка очистки поиска
      if (clearButton instanceof HTMLButtonElement) {
        clearButton.classList.toggle(
          "is-visible",
          query.length > 0
        );
      }

      // Синхронизация видимости маркеров
      document.dispatchEvent(
        new CustomEvent("streetcoffe:locations-filtered", {
          detail: {
            visibleIds: cards
              .filter((card) => !card.hasAttribute("hidden"))
              .map((card) => Number(card.getAttribute("data-location-id"))),
          },
        })
      );
    };

    // Поиск
    searchInput.addEventListener("input", updateLocations);

    // Сортировка
    sortSelect.addEventListener("change", updateLocations);

    // Очистка поиска
    clearButton?.addEventListener("click", () => {
      searchInput.value = "";
      updateLocations();
      searchInput.focus();
    });

    // Обработка отсутствующих фотографий
    section
      .querySelectorAll(".location-card__photo img")
      .forEach((image) => {
        image.addEventListener("error", () => {
          image.classList.add("image-error");
        });
      });

    updateLocations();
  };

  initLocations();

  document.addEventListener("astro:page-load", initLocations);
</script>