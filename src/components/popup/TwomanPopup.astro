---
import "./TwomanPopup.css";
---

<div class="twoman-popup" data-twoman-popup aria-hidden="true">
  <button
    class="twoman-popup__backdrop"
    type="button"
    data-twoman-close
    aria-label="Закрыть окно"
  ></button>

  <section
    class="twoman-popup__dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="twoman-popup-title"
    aria-describedby="twoman-popup-description"
    tabindex="-1"
  >
    <button
      class="twoman-popup__close"
      type="button"
      data-twoman-close
      aria-label="Закрыть окно"
    >
      <span></span><span></span>
    </button>

    <div class="twoman-popup__visual" aria-hidden="true">
      <div class="twoman-popup__rings"></div>

      <img
        class="twoman-popup__logo"
        src="/icons/twoman-mark_white.svg"
        alt=""
      />

      <span class="twoman-popup__visual-caption">
        INDEPENDENT DIGITAL BRAND
      </span>
    </div>

    <div class="twoman-popup__content">
        <div class="twoman-popup__brand">
          <img
            class="twoman-popup__brand-mark"
            src="/icons/twoman-mark.svg"
            alt=""
            aria-hidden="true"
          />
          <span class="twoman-popup__brand-name">TWOMAN</span>
          <span class="twoman-popup__brand-studio">STUDIO</span>
        </div>

      <p class="twoman-popup__eyebrow">
        ВАШ СЛЕДУЮЩИЙ ПРОЕКТ МОЖЕТ НАЧАТЬСЯ ЗДЕСЬ
      </p>

      <h2 id="twoman-popup-title">
        Понравился сайт?<br />
        <span>Хочешь такой же?</span>
      </h2>

      <p
        class="twoman-popup__description"
        id="twoman-popup-description"
      >
        Создадим сайт, который передаёт характер вашего бренда —
        от первой идеи до последней детали.
      </p>

      <div class="twoman-popup__actions">
        <a
          class="twoman-popup__button twoman-popup__button--primary"
          href="https://t.me/d1s3ct"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M21.7 3.4 18.5 20c-.2 1.2-.9 1.5-1.8 1l-5-3.7-2.4 2.3c-.3.3-.5.5-1 .5l.4-5.1 9.3-8.4c.4-.4-.1-.6-.6-.2L6 13.6 1.1 12c-1.1-.3-1.1-1 .2-1.5L20.4 3c.9-.3 1.7.2 1.3.4Z" />
          </svg>

          Написать в Telegram

          <img
            class="twoman-popup__arrow"
            src="/icons/arrow.svg"
            alt=""
            aria-hidden="true"
          />
        </a>

        <a
          class="twoman-popup__button twoman-popup__button--secondary"
          href="https://twomanstudio.ru/"
          target="_blank"
          rel="noopener noreferrer"
        >
          Посетить сайт

          <img
            class="twoman-popup__arrow"
            src="/icons/arrow.svg"
            alt=""
            aria-hidden="true"
          />
        </a>
      </div>

      <div class="twoman-popup__note">
        <i></i>
        ДИЗАЙН · РАЗРАБОТКА · DIGITAL
        <i></i>
      </div>
    </div>
  </section>
</div>

<script>
  const popup = document.querySelector<HTMLElement>(
    "[data-twoman-popup]"
  );

  if (popup && !popup.dataset.initialized) {
    popup.dataset.initialized = "true";

    const dialog = popup.querySelector<HTMLElement>(
      ".twoman-popup__dialog"
    );

    const closeButtons =
      popup.querySelectorAll<HTMLButtonElement>(
        "[data-twoman-close]"
      );

    const storageKey = "twomanStudioPopupShown";

    let opened = false;
    let previousFocus: HTMLElement | null = null;
    let ticking = false;

    const close = () => {
      if (!opened) return;

      popup.classList.remove("is-visible");
      popup.setAttribute("aria-hidden", "true");

      document.body.classList.remove("twoman-popup-open");

      opened = false;
      previousFocus?.focus();
    };

    const open = () => {
      if (
        opened ||
        sessionStorage.getItem(storageKey) === "1"
      ) return;

      sessionStorage.setItem(storageKey, "1");

      previousFocus =
        document.activeElement instanceof HTMLElement
          ? document.activeElement
          : null;

      popup.classList.add("is-visible");
      popup.setAttribute("aria-hidden", "false");

      document.body.classList.add("twoman-popup-open");

      opened = true;

      window.setTimeout(() => dialog?.focus(), 80);
    };

    const checkEnd = () => {
      ticking = false;

      if (sessionStorage.getItem(storageKey) === "1") return;

      const current = window.scrollY + window.innerHeight;

      const height = Math.max(
        document.documentElement.scrollHeight,
        document.body.scrollHeight
      );

      if (current >= height - 80) open();
    };

    const onScroll = () => {
      if (ticking) return;

      ticking = true;
      requestAnimationFrame(checkEnd);
    };

    closeButtons.forEach((button) => {
      button.addEventListener("click", close);
    });

    document.addEventListener("keydown", (event) => {
      if (!opened) return;

      if (event.key === "Escape") close();

      if (event.key === "Tab" && dialog) {
        const items = Array.from(
          dialog.querySelectorAll<HTMLElement>(
            'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
          )
        ).filter((item) => item.offsetParent !== null);

        if (!items.length) return;

        const first = items[0];
        const last = items[items.length - 1];

        if (
          event.shiftKey &&
          document.activeElement === first
        ) {
          event.preventDefault();
          last.focus();
        } else if (
          !event.shiftKey &&
          document.activeElement === last
        ) {
          event.preventDefault();
          first.focus();
        }
      }
    });

    window.addEventListener("scroll", onScroll, {
      passive: true,
    });

    window.addEventListener("resize", onScroll, {
      passive: true,
    });

    window.addEventListener(
      "load",
      onScroll,
      { once: true }
    );

    checkEnd();
  }
</script>